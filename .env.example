# Chat models (cloud Ollama; keep actual keys in .env).
OLLAMA_API_KEY=

# Required only when knowledge content needs new embeddings.
COHERE_API_KEY=

# Local PostgreSQL started by `docker compose up -d rag-db`.
# Set this to your team's shared PostgreSQL URL to use a shared server.
RAG_DATABASE_URL=postgresql://pwnai:pwnai_dev@localhost:55432/pwnai_rag
# If overriding these, update RAG_DATABASE_URL to match.
RAG_POSTGRES_PASSWORD=pwnai_dev
RAG_POSTGRES_PORT=55432

# Optional API settings.
PORT=3000
JWT_SECRET=change-this-for-your-environment
